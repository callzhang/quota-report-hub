{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/status.js": {
      "maxDuration": 30
    },
    "api/users.js": {
      "maxDuration": 30
    },
    "api/cron/invalidated-auth-notifications.js": {
      "maxDuration": 30
    },
    "api/cron/probe-auth-pool.js": {
      "maxDuration": 30
    },
    "api/cron/token-usage-retention.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/invalidated-auth-notifications",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/token-usage-retention",
      "schedule": "30 18 * * *"
    }
  ]
}
